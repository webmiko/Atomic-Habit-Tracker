# Скопируйте в .env и подставьте свои значения. Файл .env в Git не коммитится.
# Шаблон для рубрики курса (критерий 4).

# --- Django ---
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# ENABLE_PROD_SECURITY=True   # HTTPS-куки и SECURE_SSL_REDIRECT (только за TLS-прокси)
TIME_ZONE=Europe/Moscow

# --- PostgreSQL (обязательно для этого проекта) ---
DB_NAME=atomic_habits
# Homebrew Postgres на macOS: часто суперпользователь = имя ОС (whoami), не postgres
DB_USER=your-os-username
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- JWT (опционально, иначе defaults SimpleJWT) ---
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=1

# --- Docker Compose (сервис db в compose) ---
# DB_HOST=db
# DB_USER=atomic
# DB_PASSWORD=atomic

# --- CORS (фронт Bootstrap на :5500; при same-origin через Gunicorn не нужен) ---
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
FRONTEND_URL=http://localhost:5500

# --- Celery + Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Telegram Bot API (добавьте токен от @BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Email (отладка Django: письма в stdout) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost

# --- Яндекс Почта (раскомментировать для SMTP) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yandex.ru
